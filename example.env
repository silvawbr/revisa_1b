# Endpoint dedicado de geração de voz do OpenRouter.
api_url=https://openrouter.ai/api/v1/audio/speech

# Chave secreta do OpenRouter.
# Configure somente no ambiente privado local ou na hospedagem.
# Nunca adicione uma chave real ao repositório.
api_key=

# Modelo Gemini com saída Text-to-Speech.
tts_model=google/gemini-3.1-flash-tts-preview

# Voz selecionada para a leitura.
tts_voice=Zephyr

# O Gemini devolve PCM bruto pelo endpoint utilizado.
tts_response_format=pcm
